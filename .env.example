#чтобы разворачивать на локалхосте, в прод идут другие данные
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=messenger;Username=messenger;Password=change_me
ConnectionStrings__Redis=localhost:6379
Jwt__Key=change-me-to-a-random-string-of-at-least-32-characters
Cors__Origins__0=http://localhost:5173

# Файловое хранилище (S3). Локально — MinIO из docker-compose; бакет создаётся автоматически (EnsureBucket).
Storage__Endpoint=http://localhost:9000
Storage__Region=us-east-1
Storage__Bucket=messenger
Storage__AccessKey=messenger
Storage__SecretKey=messenger_dev_password
Storage__ForcePathStyle=true
Storage__EnsureBucket=true

# Прод (Render) — Yandex Object Storage; значения задаются в Environment на Render, не в репозитории:
# Storage__Endpoint=https://storage.yandexcloud.net
# Storage__Region=ru-central1
# Storage__Bucket=<имя вашего бакета>
# Storage__AccessKey=<идентификатор статического ключа сервисного аккаунта>
# Storage__SecretKey=<секретный ключ>
# Storage__ForcePathStyle=false
# Storage__EnsureBucket=false
