{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "messenger",
    "Audience": "messenger-clients",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "CookieSameSite": "Lax"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Database": {
    "AutoMigrate": false
  },
  "RateLimiting": {
    "AuthPerMinute": 10
  }
}
