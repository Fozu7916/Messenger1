{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "messenger",
    "Audience": "messenger-clients",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "CookieSameSite": "Lax"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "Endpoint": "",
    "Region": "us-east-1",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": false,
    "EnsureBucket": false
  },
  "Database": {
    "AutoMigrate": false
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "UsersPerMinute": 300,
    "MailPer15Min": 5
  },
  "Auth": {
    "RequireConfirmedEmail": false,
    "ResetTokenMinutes": 30,
    "ConfirmTokenHours": 24,
    "EmailCooldownSeconds": 60
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Resend": {
    "ApiKey": "",
    "From": "",
    "FromName": "Messenger"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "Messenger"
  }
}
